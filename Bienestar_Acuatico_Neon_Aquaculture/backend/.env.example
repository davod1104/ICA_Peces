# ---- Servidor ----
PORT=4000
NODE_ENV=development

# ---- Base de datos PostgreSQL ----
# Formato: postgres://usuario:clave@host:puerto/base
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bienestar_acuatico
# Alternativa si prefieres variables sueltas (se usan solo si DATABASE_URL está vacío)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bienestar_acuatico

# ---- Seguridad ----
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRA=8h

# ---- CORS ----
# Orígenes permitidos separados por coma. Usa * solo en desarrollo.
CORS_ORIGEN=http://localhost:8080,http://127.0.0.1:8080

# ---- Evidencias ----
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=15

# ---- Modo sin conexión en el frontend ----
MODO_OFFLINE_PERMITIDO=true
